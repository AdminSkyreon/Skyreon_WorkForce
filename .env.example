# =============================================================================
# Local development (docker compose)
# =============================================================================
POSTGRES_USER=skyreon
POSTGRES_PASSWORD=skyreon
POSTGRES_DB=skyreon
POSTGRES_PORT=5433

# Backend — local fallback when SUPABASE_DATABASE_URL is empty
DATABASE_URL=postgresql+asyncpg://skyreon:skyreon@localhost:5433/skyreon

# Optional: point local API at Supabase instead of compose postgres
# SUPABASE_DATABASE_URL=postgresql://postgres.xxxx:YOUR_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:3000
ADMIN_EMAIL=admin@skyreon.com
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=Skyreon Admin
SUPER_ADMIN_EMAIL=superadmin@skyreon.com
SUPER_ADMIN_PASSWORD=ChangeMe123!

# Frontend (local — direct to API, no Vercel proxy)
NEXT_PUBLIC_API_URL=http://localhost:8000

# =============================================================================
# Production — Supabase + Render + Vercel (set in host dashboards, not in git)
# =============================================================================
#
# Supabase (Render env):
#   SUPABASE_DATABASE_URL=postgresql://postgres.[ref]:[password]@....pooler.supabase.com:5432/postgres
#
# Render Web Service (backend/ Docker):
#   SUPABASE_DATABASE_URL=...
#   JWT_SECRET=<long-random>
#   COOKIE_SECURE=true
#   CORS_ORIGINS=https://your-app.vercel.app
#   ADMIN_EMAIL / ADMIN_PASSWORD / SUPER_ADMIN_* as needed
#
# Vercel (frontend/ root):
#   NEXT_PUBLIC_API_URL=https://your-app.vercel.app
#   API_PROXY_TARGET=https://your-service.onrender.com
#
# Full steps: docs/DEPLOY.md
